---
// 各內頁頂部橫幅：有上傳圖片就當背景，沒有就維持深色漸層
interface Props {
  subtitle: string;
  title: string;
  image?: string;
}

const { subtitle, title, image } = Astro.props;
---

<section class={`relative overflow-hidden px-6 ${image ? 'pt-48 pb-28' : 'pt-40 pb-20'}`}>
  {image ? (
    <>
      <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-b from-film-black/40 via-film-black/30 to-film-black"></div>
    </>
  ) : (
    <div class="absolute inset-0 bg-gradient-to-b from-film-gray to-film-black"></div>
  )}
  <div class="relative z-10 max-w-7xl mx-auto">
    <p class="text-film-gold text-xs tracking-[0.4em] uppercase mb-4">{subtitle}</p>
    <h1 class="font-display text-5xl md:text-7xl text-white font-bold">{title}</h1>
  </div>
</section>
