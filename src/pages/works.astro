---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import site from '../content/settings/site.json';

const allWorks = await getCollection('works').catch(() => []);
const works = allWorks.sort((a, b) => String(b.data.year ?? '').localeCompare(String(a.data.year ?? '')));

// 後台貼一般 YouTube 網址即可（watch?v=、youtu.be、shorts、embed 都接受）
function toEmbed(url?: string) {
  if (!url) return '';
  const m = url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : '';
}
---

<BaseLayout
  title="作品預告 | 影視傳播系"
  description="黎明技術學院影視傳播系學生作品精選，包含短片、紀錄片、實驗影像等多元類型，多部作品曾入圍或獲得國內外影展獎項肯定。"
  keywords="影視傳播系學生作品,電影系短片,學生影片,影視系畢業製作,台灣學生電影"
>

  <PageHero subtitle="Student Works" title="作品預告" />

  <section class="py-16 px-6">
    <div class="max-w-7xl mx-auto reveal">
      <p class="text-film-light/60 max-w-2xl leading-relaxed text-lg">
        這裡展示學生的創作成果與精選預告，從短片、紀錄片到實驗影像，
        每一個作品都是學生對世界的獨特詮釋。
      </p>
    </div>
  </section>

  <section data-section="精選作品" class="py-12 px-6">
    <div class="max-w-7xl mx-auto space-y-16">
      {works.length === 0 && (
        <p class="text-film-light/40 text-sm">尚無作品，請至後台「🎬 作品預告」新增。</p>
      )}
      {works.map((work, i) => {
        const embed = toEmbed(work.data.youtube);
        return (
          <div class="reveal grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="aspect-video bg-film-gray border border-white/10 overflow-hidden">
                {embed ? (
                  <iframe
                    src={embed}
                    title={work.data.title}
                    class="w-full h-full"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                ) : work.data.cover ? (
                  <img src={work.data.cover} alt={work.data.title} class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="text-film-gold/20 font-display text-6xl">影</span>
                  </div>
                )}
              </div>
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="flex items-center gap-4 mb-4">
                {work.data.type && <span class="text-xs border border-film-gold/50 text-film-gold px-3 py-1">{work.data.type}</span>}
                {work.data.year && <span class="text-film-light/40 text-xs">{work.data.year}</span>}
              </div>
              <h2 class="font-display text-3xl text-white font-bold mb-4">{work.data.title}</h2>
              <p class="text-film-light/60 leading-relaxed mb-6 whitespace-pre-line">{work.data.description}</p>
              {work.data.award && (
                <div class="flex items-center gap-3 text-film-gold text-sm">
                  <span>🏆</span>
                  <span>{work.data.award}</span>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  {site.youtube_channel && (
    <section class="py-24 px-6 bg-film-gray">
      <div class="max-w-3xl mx-auto text-center reveal">
        <p class="text-film-gold text-xs tracking-[0.4em] uppercase mb-6">More Works</p>
        <h2 class="font-display text-3xl text-white mb-6">更多作品陸續上線</h2>
        <p class="text-film-light/60 mb-10">關注我們的 YouTube 頻道，第一時間掌握最新學生作品。</p>
        <a href={site.youtube_channel} target="_blank" rel="noopener"
          class="inline-block px-10 py-4 border border-film-gold text-film-gold text-sm tracking-widest uppercase hover:bg-film-gold hover:text-film-black transition-colors duration-300">
          前往 YouTube 頻道
        </a>
      </div>
    </section>
  )}

</BaseLayout>
