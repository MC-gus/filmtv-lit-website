---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面 | 影視傳播系" description="您要找的頁面不存在。">
  <section class="min-h-screen flex items-center justify-center px-6 text-center">
    <div>
      <p class="text-film-gold text-xs tracking-[0.4em] uppercase mb-6">404 · Scene Not Found</p>
      <h1 class="font-display text-5xl md:text-7xl text-white font-bold mb-6">這一幕被剪掉了</h1>
      <p class="text-film-light/60 mb-12">您要找的頁面不存在，可能已經移動或刪除。</p>
      <a href="/"
        class="inline-block px-10 py-4 bg-film-gold text-film-black font-semibold text-sm tracking-widest uppercase hover:bg-white transition-colors duration-300">
        回到首頁
      </a>
    </div>
  </section>
</BaseLayout>
